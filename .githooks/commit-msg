#!/bin/sh
# Reject AI/tool attribution trailers in commit messages.
# Enable once per clone:  git config core.hooksPath .githooks
# CI runs the same check (.github/workflows/checks.yml).

if grep -qiE '^[[:space:]]*co-authored-by:|generated with \[?claude code' "$1"; then
  echo "commit-msg: remove the 'Co-Authored-By:' / 'Generated with Claude Code' line; this repository does not use attribution trailers." >&2
  exit 1
fi
