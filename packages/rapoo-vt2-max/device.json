{
  "transport": {
    "type": "registers",
    "interface": "command",
    "reportLength": 33,
    "read": "06 A5 A4 {len} {addr:u16le} 00 00",
    "write": "06 A5 A5 {len} {addr:u16le} 00 00 {data}",
    "maxChunk": 20,
    "writeBlock": 4,
    "readable": [{ "from": "0x0600", "to": "0x08FF" }],
    "response": {
      "reportId": 6,
      "status": 0,
      "data": 4,
      "ready": [1],
      "busy": [2],
      "pending": [0],
      "pendingCode": "asleep",
      "timeoutMs": 1000
    }
  },

  "codecs": {
    "action": {
      "size": 4,
      "variants": [
        { "kind": "mouse", "bytes": "03 00 {value} 00", "values": [1, 2, 4, 8, 16] },
        { "kind": "key", "bytes": "00 00 {value} 00", "range": { "min": 4, "max": 115 }, "display": "hidKey" },
        { "kind": "dpiUp", "bytes": "08 00 05 00" },
        { "kind": "dpiDown", "bytes": "08 00 06 00" },
        { "kind": "wheel", "bytes": "07 00 {value} 00", "readOnly": true },
        { "kind": "disabled", "bytes": "FF FF FF FF" }
      ]
    }
  },

  "settings": [
    {
      "id": "dpi", "at": ["0x0888", "0x08C8"], "type": "u16le", "count": 7,
      "range": { "min": 50, "max": 26000, "step": 10 }, "unit": "DPI",
      "write": [{ "at": "0x0888", "len": 20 }, { "at": "0x08C8", "len": 16 }],
      "countFrom": "stageCount", "control": "stages"
    },
    { "id": "stageCount", "at": "0x0896", "type": "u8", "linear": { "scale": 1, "offset": 1 }, "readOnly": true },
    { "id": "active", "at": ["0x0898", "0x089A"], "type": "u8", "indexOf": "dpi", "write": [{ "at": "0x0898", "len": 4 }] },
    {
      "id": "polling", "at": "0x0880", "type": "u8", "unit": "Hz", "control": "segmented",
      "values": [
        { "value": 125, "raw": "0x08" },
        { "value": 250, "raw": "0x04" },
        { "value": 500, "raw": "0x02" },
        { "value": 1000, "raw": "0x01" },
        { "value": 2000, "raw": "0x84" },
        { "value": 4000, "raw": "0x82" },
        { "value": 8000, "raw": "0x81" }
      ]
    },
    { "id": "motionSync", "at": "0x0885", "type": "bool" },
    { "id": "linear", "at": "0x08C3", "type": "bit", "bit": 0, "invert": true },
    { "id": "ripple", "at": "0x08C3", "type": "bit", "bit": 1, "invert": true },
    { "id": "glass", "at": "0x08C5", "type": "bool" },
    {
      "id": "lod", "at": "0x0884", "type": "u8", "linear": { "scale": 0.1, "offset": 0.6 },
      "range": { "min": 0.7, "max": 1.7, "step": 0.1 }, "unit": "mm", "control": "slider"
    },
    { "id": "debounce", "at": "0x08C0", "type": "u8", "range": { "min": 0, "max": 32, "step": 1 }, "unit": "ms", "control": "slider" },
    { "id": "debounceRelease", "at": "0x08C1", "type": "u8", "unit": "ms", "readOnly": true },
    { "id": "angle", "at": "0x08C4", "type": "i8", "unit": "°", "readOnly": true },
    { "id": "buttons", "at": "0x0600", "type": "action", "count": 10 }
  ],

  "status": {
    "interface": "status",
    "reportId": 7,
    "match": [{ "at": 0, "mask": "0xF0", "equals": "0x20" }],
    "fields": [
      { "id": "stage", "at": 1, "type": "u8" },
      { "id": "dpi", "at": 2, "type": "u16le" },
      { "id": "charging", "at": 6, "type": "bool", "equals": 2 },
      { "id": "battery", "at": 7, "type": "u8", "unit": "%" },
      { "id": "polling", "at": 9, "type": "u8", "valuesFrom": "polling" },
      { "id": "wired", "at": 0, "type": "bit", "bit": 1 }
    ]
  },

  "tray": {
    "battery": { "level": "battery", "charging": "charging" },
    "header": "tray.header",
    "items": [
      { "setting": "active", "label": "tray.dpi" },
      { "setting": "polling" },
      { "setting": "motionSync" },
      { "setting": "glass" },
      { "refresh": true }
    ]
  },

  "pages": [
    { "id": "dpi", "icon": "dpi", "settings": ["dpi", "active"] },
    { "id": "performance", "icon": "performance", "settings": ["polling"] },
    { "id": "sensor", "icon": "sensor", "settings": ["motionSync", "linear", "ripple", "glass", "lod", "debounce", "debounceRelease"] },
    { "id": "buttons", "icon": "buttons", "settings": ["buttons"] }
  ],

  "examples": [
    {
      "note": "polling 1000 Hz (captured)",
      "memory": { "0x0880": "08 06 FF FF" },
      "set": { "id": "polling", "value": 1000 },
      "writes": ["06 A5 A5 04 80 08 00 00 01 06 FF FF"]
    },
    {
      "note": "back button -> middle click (captured)",
      "set": { "id": "buttons", "index": 6, "value": { "kind": "mouse", "value": 4 } },
      "writes": ["06 A5 A5 04 18 06 00 00 03 00 04 00"]
    },
    {
      "note": "back button -> key A (captured)",
      "set": { "id": "buttons", "index": 6, "value": { "kind": "key", "value": 4 } },
      "writes": ["06 A5 A5 04 18 06 00 00 00 00 04 00"]
    },
    {
      "note": "stage 2 -> 810 DPI (X block captured; Y block mirrors it)",
      "memory": {
        "0x0888": "90 01 20 03 B0 04 40 06 80 0C 00 19 90 65 06 00 01 00 01 02",
        "0x08C8": "90 01 20 03 B0 04 40 06 80 0C 00 19 90 65 00 00"
      },
      "set": { "id": "dpi", "index": 1, "value": 810 },
      "writes": [
        "06 A5 A5 14 88 08 00 00 90 01 2A 03 B0 04 40 06 80 0C 00 19 90 65 06 00 01 00 01 02",
        "06 A5 A5 10 C8 08 00 00 90 01 2A 03 B0 04 40 06 80 0C 00 19 90 65 00 00"
      ]
    }
  ],

  "demo": {
    "product": "VT2 Max",
    "serial": "DEMO",
    "config": {
      "dpi": [400, 800, 1600, 3200, 6400, 12800, 26000], "stageCount": 5, "active": 1, "polling": 1000,
      "motionSync": true, "linear": false, "ripple": true, "glass": false, "lod": 1.1,
      "debounce": 4, "debounceRelease": 4, "angle": 0,
      "buttons": [
        { "kind": "mouse", "value": 1 }, { "kind": "mouse", "value": 4 }, { "kind": "mouse", "value": 2 },
        { "kind": "dpiUp" }, { "kind": "dpiDown" }, { "kind": "mouse", "value": 16 }, { "kind": "mouse", "value": 8 },
        { "kind": "wheel", "value": 1 }, { "kind": "wheel", "value": 2 }, { "kind": "key", "value": 104 }
      ]
    },
    "status": { "stage": 1, "dpi": 800, "charging": false, "battery": 76, "polling": 1000, "wired": false }
  }
}
