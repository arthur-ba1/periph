{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Periph",
  "version": "0.1.0",
  "identifier": "io.github.arthur-ba1.periph",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../app/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Periph",
        "width": 1040,
        "height": 660,
        "minWidth": 900,
        "minHeight": 580,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "visible": false,
        "center": true,
        "backgroundColor": "#0b0b12"
      },
      {
        "label": "tray",
        "title": "Periph",
        "width": 320,
        "height": 240,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "visible": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "focus": false,
        "backgroundColor": "#161616"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
